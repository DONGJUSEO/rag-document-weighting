# Copy this file to `.env` and fill in your API credentials.
# Do NOT commit `.env` (it is gitignored).
# NOTE: only run_e5_llm_pairs.py auto-loads `.env`; the main pipeline
# (run_main.py, run_all_*.sh) reads os.environ only — `export` the
# variables in your shell (see README, "Reproducing Main Results").

# ----- API credentials -----
TOGETHER_API_KEY=<your_together_ai_key>
OPENAI_API_KEY=<your_openai_key>
HF_TOKEN=<your_huggingface_token>

# ----- Model selection -----
# Backend: "together" (open-source via Together AI), "openai", or "hf" (local HF)
LLM_BACKEND=together

# Model name (must match the backend)
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-Turbo
# Other supported models:
#   meta-llama/Llama-3.3-70B-Instruct-Turbo  (LLM_BACKEND=together)
#   gpt-4.1-mini                              (LLM_BACKEND=openai)

# ----- Path overrides (optional) -----
# Defaults: <repo_root>/data, <repo_root>/results, <repo_root>/figures
# DATA_DIR=/custom/path/to/data
# RESULTS_DIR=/custom/path/to/results
# FIGURES_DIR=/custom/path/to/figures
